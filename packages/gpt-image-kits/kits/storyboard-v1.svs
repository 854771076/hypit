<?svml using="@hypit/text/svs@1"?>

<sheet version="1" id="storyboard-v1">
  text-template.storyboard-v1 {
    separator: paragraph;
    default-board-type: single-frame;
  }

  text-template.storyboard-v1.block.purpose { kind: fixed; order: 10; text: "Create production evidence for one atomic shot. A story board explains what the audience must understand and feel; a shot board explains how the camera must cover it. Preserve the selected character, appearance version, location geometry, prop state, visual bible, and screen direction from the connected references."; }
  text-template.storyboard-v1.block.board-type { kind: axis; order: 20; parameter: board-type; }
  text-template.storyboard-v1.choice.board-type.single-frame { text: "BOARD TYPE — KEYFRAME: produce one full-frame image for a decisive composition or approved first/last state. Use this when identity, layout, look, or a single continuity checkpoint is the only uncertainty. No grid, split screen, border, inset, or alternate angle."; }
  text-template.storyboard-v1.choice.board-type.temporal { text: "BOARD TYPE — TEMPORAL STORYBOARD: produce a clean ordered multi-cell board for one continuous shot's physical action. Use it when the model must understand onset, anticipation, contact or change, and the stable tail. Default to six clearly ordered cells; keep one camera relationship and one time/place. Do not turn cells into coverage or alternate angles."; }
  text-template.storyboard-v1.choice.board-type.narrative { text: "BOARD TYPE — NARRATIVE STORYBOARD: produce a clean ordered multi-cell board for audience-facing story beats inside one atomic shot. Use it when causality, discovery, emotional turn, reveal, or reaction matters more than exact mechanics. Each cell states the subject's intention, the new information, and the resulting audience-readable change; keep the same world and screen direction, and do not prescribe a coverage plan."; }
  text-template.storyboard-v1.choice.board-type.shot-board { text: "BOARD TYPE — SHOT BOARD: produce a clean ordered multi-cell technical coverage plan. Use it to resolve camera size/angle, speaker-listener staging, blocking, screen direction, hand ownership, prop contact, and the exact views the shot must cut between. Each cell is a distinct intended view; do not use this type to explain an emotional arc or continuous motion."; }
  text-template.storyboard-v1.choice.board-type.blocking { text: "BOARD TYPE — BLOCKING STORYBOARD: map a character's route through a fixed space, including start marks, destinations, handoffs, crossings, entrances, exits, and camera path. Use it for kitchen-to-table, chase, crowd, or multi-person staging; prioritize spatial continuity over expressive detail."; }
  text-template.storyboard-v1.choice.board-type.action { text: "BOARD TYPE — ACTION BREAKDOWN STORYBOARD: break a fight, stunt, chase, or impact into readable preparation, attack, contact, reaction, recovery, and result. Use directional arrows and restrained effect marks only as planning annotations; preserve anatomy, contact points, and cause-and-effect."; }
  text-template.storyboard-v1.choice.board-type.choreography { text: "BOARD TYPE — CHOREOGRAPHY STORYBOARD: teach a repeatable movement sequence step by step, with one distinct pose or transition per cell, foot placement, weight shift, and trajectory. Use it for dance, sports, martial arts, or complex body mechanics; it is not a coverage plan."; }
  text-template.storyboard-v1.choice.board-type.comprehensive { text: "BOARD TYPE — COMPREHENSIVE STORYBOARD: combine narrative beats, shot language, blocking, action, sound cues, lighting direction, prop states, and continuity into one approved sequence. Use only for a high-risk hero sequence that needs a single source of truth; do not invent details to fill empty slots."; }
  text-template.storyboard-v1.choice.board-type.director-track { text: "BOARD TYPE — DIRECTOR-TRACK STORYBOARD: add a compact header, continuity rules, emotional/tension curve, visual style lock, and aligned rhythm tracks for camera, action, and intensity beneath the cells. Use it for director review and team handoff, not as a literal video layout."; }
  text-template.storyboard-v1.choice.board-type.previz-3d { text: "BOARD TYPE — 3D PREVIZ STORYBOARD: use neutral faceless proxy figures and simple matte geometry to prove scale, pose, contact, axis, camera path, and spatial timing. Use it when still drawings cannot prove a complex route or multi-person interaction; never finalize character appearance here."; }
  text-template.storyboard-v1.choice.board-type.scene-overview { text: "BOARD TYPE — SCENE OVERVIEW: create a top-down or aerial establishing plan of the whole environment, showing zones, paths, landmarks, entrances, exits, and crowd or prop clusters. Use it before shot planning to lock the world layout; do not turn it into a perspective beauty shot."; }
  text-template.storyboard-v1.choice.board-type.scene-plan { text: "BOARD TYPE — SCENE PLAN: create a measured top-down floor plan with rooms, boundaries, furniture, doors, windows, and usable camera marks. Use it to prevent spatial contradictions across shots; keep the plan legible and non-cinematic."; }
  text-template.storyboard-v1.choice.board-type.scene-turnaround { text: "BOARD TYPE — SCENE TURNAROUND: show the same approved location from a small set of consistent angles, preserving object identity, placement, scale, and order. Use it to build a reusable scene reference; it is not a sequence of changing locations."; }
  text-template.storyboard-v1.block.shot { kind: slot; order: 30; slot: shot; optional: false; label: "ATOMIC SHOT CONTRACT:"; }
  text-template.storyboard-v1.block.continuity { kind: slot; order: 40; slot: continuity; optional: false; label: "START/END CONTINUITY:"; }
  text-template.storyboard-v1.block.references { kind: slot; order: 50; slot: references; optional: true; label: "REFERENCE RESPONSIBILITIES:"; }
  text-template.storyboard-v1.block.style { kind: slot; order: 60; slot: style; optional: true; label: "VISUAL BIBLE:"; }
  text-template.storyboard-v1.block.text { kind: slot; order: 70; slot: visible-text; optional: true; label: "APPROVED VISIBLE STORY TEXT ONLY:"; }
  text-template.storyboard-v1.block.hygiene { kind: fixed; order: 80; text: "Make character count, left/right and depth order, gaze, limb ownership, contact points, held props, camera side, light direction, and action progression unambiguous. For KEYFRAME show one approved state; for ACTION STORYBOARD show exact physical states; for NARRATIVE STORYBOARD show the causal or emotional change; for SHOT BOARD show each required camera view; for BLOCKING, ACTION, CHOREOGRAPHY, DIRECTOR-TRACK, or PREVIZ show only the planning evidence that type needs; for SCENE OVERVIEW, SCENE PLAN, or SCENE TURNAROUND preserve the approved environment geometry. This approved board becomes a semantic reference for the video model. Planning annotations may appear only when the selected type explicitly requires them and must stay outside the drawn panels; the generated video must never render grids, arrows, labels, or annotations. For every hard-to-reproduce detail such as a countdown, display change, hand contact, prop state, or exact pose, show each required exact state in its own cell. Do not add new people, props, weather, architecture, lighting effects, or action facts."; }
</sheet>
